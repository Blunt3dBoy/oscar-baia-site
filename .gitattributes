# Normalise all text to LF in the repo and on checkout, so the Mac and the
# Windows machine agree regardless of each one's core.autocrlf setting.
* text=auto eol=lf

# Shell scripts must keep LF — CRLF breaks the shebang line.
*.sh text eol=lf

# Binary assets: never touched, never diffed as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.mp3  binary
*.zip  binary
*.ico  binary
*.woff  binary
*.woff2 binary
